# Clearance Environment Variables
# Copy this file to .env and fill in your values
# NEVER COMMIT .env - only .env.example should be in version control

# Azure Resource Group
AZURE_RESOURCE_GROUP=clearance-rg
AZURE_LOCATION=australiaeast

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key-here
COSMOS_DATABASE=clearance-db

# Azure Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-docint.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=your-docint-key-here

# Azure Blob Storage
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
STORAGE_ACCOUNT_NAME=clearancestoragedev

# Azure Static Web Apps
SWA_URL=https://your-app.azurestaticapps.net

# Azure Functions
FUNCTIONS_URL=https://your-functions.azurewebsites.net

# Microsoft Entra ID (Authentication)
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_TENANT_ID=your-tenant-id

# Application Insights
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Demo Mode (set to "true" to bypass Azure services during demo)
DEMO_MODE=false

# Access Control & Credit Protection
CLEARANCE_ENABLED=true                    # Kill switch - set to "false" to block all assessments
CLEARANCE_DAILY_CAP=10                    # Max assessments per day globally
CLEARANCE_PAGE_LIMIT=20                   # Max pages per document
CLEARANCE_FREE_SCANS_PER_DOMAIN=2         # Free scans before requiring pilot signup

# Email Notifications (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx           # Get from https://resend.com/api-keys
NOTIFICATION_EMAIL=your-email@example.com  # Your email to receive pilot access notifications
